# A tiny website. Run it, then open http://localhost:8080 in your browser.

set visits to 0

make page with request
    add 1 to visits

    if request.path is "/"
        give back """
            <h1>Hello from Lumo!</h1>
            <p>This page has been visited {visits} times.</p>
            <p>Try <a href="/hello?name=Sam">/hello?name=Sam</a> or <a href="/time">/time</a>.</p>
            """
    end

    if request.path is "/hello"
        set name to "stranger"
        if request.query contains "name" then set name to request.query.name
        give back "<h1>Hi, {name}!</h1>"
    end

    if request.path is "/time"
        give back {date: today(), time: time()}
    end

    give back {status: 404, body: "There's no page at {request.path}"}
end

serve(page, 8080)
